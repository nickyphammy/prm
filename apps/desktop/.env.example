# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Desktop app)
MAIN_VITE_GOOGLE_CLIENT_ID=
# Desktop-app client secrets are not confidential per Google's docs, but keep this file out of git anyway.
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Notion public integration client ID (the secret lives only on the auth proxy)
MAIN_VITE_NOTION_CLIENT_ID=
# Base URL of the deployed auth proxy, e.g. https://prm-auth-proxy.vercel.app (http://localhost:3000 with `vercel dev`)
MAIN_VITE_AUTH_PROXY_URL=
